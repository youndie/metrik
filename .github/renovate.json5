{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",

  extends: ["config:recommended"],

  // Once a week, in UTC. Updates arrive as one Monday-morning batch rather than a
  // trickle of a PR a day — every PR runs the full build, and that build is not cheap.
  timezone: "Etc/UTC",
  schedule: ["before 6am on monday"],

  // Unlike tracy, the history here is conventional commits with scopes (`fix(web):`, `feat(chart):`),
  // so keep the prefixes. config:recommended maps dependency bumps to `fix:` and the rest to `chore:`.
  semanticCommits: "enabled",

  labels: ["dependencies"],

  // With the build harness merging itself these numbers stop being a throttle on human attention
  // and become one on runner time, so they can be higher.
  prConcurrentLimit: 5,
  prHourlyLimit: 0,

  // Renovate merges the pull request itself rather than arming GitHub's auto-merge. Measured,
  // not chosen: `enablePullRequestAutoMerge` is refused here with "Protected branch rules not
  // configured for this branch" and "Pull request is in clean status" — GitHub will not arm
  // auto-merge on a branch with no required checks, because there is nothing for it to wait for.
  // Turning that on would mean branch protection on `main`, and direct pushes to `main` are the
  // established way of working in these repositories.
  platformAutomerge: false,

  // Vulnerabilities are the one thing that ignores the schedule.
  vulnerabilityAlerts: {
    schedule: ["at any time"],
    labels: ["dependencies", "security"],
  },

  // kotlin-js-store holds a lock file the Kotlin/JS plugin generates for itself.
  ignorePaths: ["**/build/**", "**/.gradle/**", "kotlin-js-store/**"],

  // The catalog's `ktlint` entry is the CLI version, read by build.gradle.kts through
  // libs.versions.ktlint.get(). No library or plugin references it, so the gradle
  // manager never sees it — without this it would stay at 1.8.0 forever.
  customManagers: [
    {
      customType: "regex",
      managerFilePatterns: ["/^gradle/libs\\.versions\\.toml$/"],
      matchStrings: [
        "# renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?)\\s+ktlint\\s*=\\s*\"(?<currentValue>.*?)\"",
      ],
    },
  ],

  packageRules: [
    {
      description: "Kotlin: the compiler and its plugins move as one version, and that is never a routine bump",
      matchPackageNames: ["/^org\\.jetbrains\\.kotlin[:.]/"],
      groupName: "kotlin",
    },
    {
      description: "kotlinx ships as one release train — one PR",
      matchPackageNames: ["/^org\\.jetbrains\\.kotlinx[:.]/"],
      groupName: "kotlinx",
    },
    {
      description: "kotlinx-datetime publishes `-compat` builds for consumers pinned to an older line. They sort as newer and are not upgrades",
      matchPackageNames: ["org.jetbrains.kotlinx:kotlinx-datetime"],
      allowedVersions: "!/-compat$/",
    },
    {
      description: "Compose Multiplatform and everything that releases with it (lifecycle, navigation3)",
      matchPackageNames: [
        "/^org\\.jetbrains\\.compose[:.]/",
        "/^org\\.jetbrains\\.androidx\\./",
      ],
      groupName: "compose multiplatform",
    },
    {
      description: "Koin — one BOM, one version",
      matchPackageNames: ["/^io\\.insert-koin[:.]/"],
      groupName: "koin",
    },
    {
      description: "The build harness arrives as one PR, not one per action",
      matchManagers: ["github-actions"],
      groupName: "ci actions",
    },
    {
      description: "ktlint is build tooling, not a runtime dependency",
      matchPackageNames: [
        "/^org\\.jlleitschuh\\.gradle\\.ktlint[:.]/",
        "/^com\\.pinterest\\.ktlint[:.]/",
      ],
      matchUpdateTypes: ["minor", "patch"],
      automerge: true,
    },
    {
      description: "Base images: changing the JDK or the distro is a decision, not a bump",
      matchManagers: ["dockerfile"],
      automerge: false,
      // Own branch, so an image never shares a PR with something that may automerge — one dep
      // that may not holds back the whole PR. In tracy and katcher this is concrete: the build
      // stage is called `gradle` and moves in step with the wrapper. Here it is preventative,
      // and the reason stands either way — no check on a pull request builds the Dockerfile.
      additionalBranchPrefix: "docker-",
    },
    {
      description: "Majors of anything that ships get a human",
      matchUpdateTypes: ["major"],
      automerge: false,
      labels: ["dependencies", "major"],
    },
    // Last, so it wins over the major rule above. This ordering is the whole point: a major of
    // `actions/checkout` is not the same kind of event as a major of Ktor. The build harness is
    // not shipped to anyone, and the check that would catch a bad bump is the build itself —
    // which already ran on the PR. Requiring a human there buys nothing and costs a merge queue
    // that nobody drains.
    {
      description: "The build harness merges itself, majors included: CI on pull_request is the review",
      matchManagers: ["github-actions", "gradle-wrapper"],
      automerge: true,
      automergeType: "pr",
    },
  ],
}
